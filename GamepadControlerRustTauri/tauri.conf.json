{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GamepadControler",
  "version": "0.0.35",
  "identifier": "com.steamlike.gamepadcontroler",
  "build": {
    "frontendDist": "frontend",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Gamepad 键鼠映射",
        "width": 920,
        "height": 640,
        "minWidth": 760,
        "minHeight": 500,
        "resizable": true,
        "center": true,
        "backgroundColor": "#26282c",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
